{
  "id": "hangout/",
  "name": "Hang Out",
  "short_name": "Hang Out",
  "description": "Hang Out, Game Night, and WebJam.",
  "start_url": "hangout/",
  "scope": "./",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "display": "standalone",
  "background_color": "#171410",
  "theme_color": "#171410",
  "lang": "en",
  "icons": [
    {
      "src": "assets/hangout-app/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/hangout-app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/hangout-app/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/hangout-app/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/hangout-app/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Game Night",
      "short_name": "Game Night",
      "description": "Play a game with friends.",
      "url": "hangout/?go=game-night",
      "icons": [
        {
          "src": "assets/hangout-app/shortcut-game-night.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "WebJam",
      "short_name": "WebJam",
      "description": "Join a music session.",
      "url": "hangout/?go=webjam",
      "icons": [
        {
          "src": "assets/hangout-app/shortcut-webjam.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Last room",
      "short_name": "Last room",
      "description": "Open the last Hang Out place on this device.",
      "url": "hangout/?go=last",
      "icons": [
        {
          "src": "assets/hangout-app/shortcut-last-room.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
